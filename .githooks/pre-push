#!/usr/bin/env bash
set -euo pipefail

if ! command -v ripsecrets >/dev/null 2>&1; then
  echo "ERROR: 'ripsecrets' is required to push safely."
  echo "Install it with: brew install ripsecrets  (or: cargo install ripsecrets)"
  exit 1
fi

tracked_files=()
while IFS= read -r -d '' file; do
  if [ -f "$file" ]; then
    tracked_files+=("$file")
  fi
done < <(git ls-files -z)

if [ "${#tracked_files[@]}" -eq 0 ]; then
  exit 0
fi

echo "==> Scanning ${#tracked_files[@]} tracked file(s) with ripsecrets before push..."
ripsecrets --strict-ignore "${tracked_files[@]}"
