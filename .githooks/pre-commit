#!/usr/bin/env bash
set -euo pipefail

if ! command -v ripsecrets >/dev/null 2>&1; then
  echo "ERROR: 'ripsecrets' is required to commit safely."
  echo "Install it with: brew install ripsecrets  (or: cargo install ripsecrets)"
  exit 1
fi

staged_files=()
while IFS= read -r -d '' file; do
  if [ -f "$file" ]; then
    staged_files+=("$file")
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "${#staged_files[@]}" -eq 0 ]; then
  exit 0
fi

echo "==> Scanning ${#staged_files[@]} staged file(s) with ripsecrets..."
ripsecrets --strict-ignore "${staged_files[@]}"
